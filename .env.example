# Variáveis de ambiente - Portal Casa Eficiente
# Copie para .env para desenvolvimento local

# =============================================================================
# Base de dados PostgreSQL
# =============================================================================
# Para desenvolvimento local ou Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portal_casa_eficiente?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/portal_casa_eficiente?schema=public"

# =============================================================================
# Autenticação (NextAuth v5)
# =============================================================================
# Gerar secret seguro: openssl rand -base64 32
AUTH_SECRET="gerar-secret-seguro-com-openssl-rand-base64-32"
NEXTAUTH_SECRET="gerar-secret-seguro-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# Email (Resend) - Opcional para testes locais
# =============================================================================
RESEND_API_KEY=""
EMAIL_FROM="Portal Casa Eficiente <no-reply@example.com>"
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# =============================================================================
# Storage S3-Compatível (Minio, DigitalOcean Spaces, AWS S3)
# =============================================================================
# Opcional: necessário apenas para funcionalidades de upload de documentos
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="portal-casa-eficiente"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# =============================================================================
# Supabase (Opcional)
# =============================================================================
# Necessário apenas se usar Supabase Storage
SUPABASE_URL=""
SUPABASE_KEY=""

# =============================================================================
# Configuração de Workers de Ingestão
# =============================================================================
INGEST_CRON="0 6 * * *"  # Diariamente às 6h (formato cron)
DR_SEARCH_URL="https://dre.pt/web/guest/pesquisa"
FUNDO_AMBIENTAL_URL="https://www.fundoambiental.pt/avisos"

# Discovery Municipal - Configuração
MUNICIPAL_DISCOVERY_LIMIT="308"
MUNICIPAL_REQUEST_DELAY_MS="500"
MUNICIPAL_SCAN_PATH_LIMIT="10"
# MUNICIPAL_WEBSITES_DATASET_URL=""
# MUNICIPAL_WEBSITES_RESOURCE_URLS=""
# MUNICIPAL_WEBSITES_UDATA_DATASET_URL=""

# Validação Postal - Configuração
# POSTAL_CACHE_TTL_DAYS="30"
# POSTAL_VALIDATION_TIMEOUT_MS="5000"

# Debug - Diário da República
# DRE_DEBUG_API="false"

# =============================================================================
# Configuração de Ambiente
# =============================================================================
NODE_ENV="development"

# =============================================================================
# Segurança de Cron Jobs (Produção)
# =============================================================================
# Necessário em produção para proteger endpoint /api/cron/ingest
# CRON_SECRET="secret-aleatorio-para-proteger-cron-endpoint"

